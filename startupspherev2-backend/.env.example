# Example environment variables for local development
# Copy this to `.env` or set real environment variables in your environment.

# SendGrid API key (optional)
SENDGRID_API_KEY=your_sendgrid_api_key

# JDBC URL for Postgres (production). The app will fall back to H2 when missing.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/startupsphere?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# Base64-encoded 256-bit secret for JWT signing. Example placeholder:
# You can generate one with: openssl rand -base64 32
SECURITY_JWT_SECRET_KEY=<BASE64_SECRET_KEY>
# Copy this file to .env and fill in your values
# Keep .env out of git by default.

SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.lkhnygiipqvgugaastax
SPRING_DATASOURCE_PASSWORD=<YOUR_DB_PASSWORD>
SECURITY_JWT_SECRET_KEY=<BASE64_SECRET_KEY>
SENDGRID_API_KEY=<YOUR_SENDGRID_API_KEY>
