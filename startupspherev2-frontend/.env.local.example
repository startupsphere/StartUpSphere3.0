# Frontend local environment template
# Copy to `.env.local` and edit for your dev environment

# Backend base URL (frontend dev server proxies API calls to this when running via Vite)
VITE_BACKEND_URL=http://localhost:54759

# Mapbox token (obtain from https://www.mapbox.com)
VITE_MAPBOX_TOKEN=YOUR_MAPBOX_TOKEN_HERE

# Set to 'true' to serve frontend over HTTPS (requires valid local certs)
VITE_USE_HTTPS=false
