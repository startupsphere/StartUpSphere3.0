# StartUpSphere Frontend Environment Template
# Duplicate this file, rename it to '.env', and fill in your private API keys.

VITE_BACKEND_URL=http://localhost:8080
# Groq Cloud API Key from https://console.groq.com
VITE_GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# Fast Groq model identifier (e.g. openai/gpt-oss-120b, openai/gpt-oss-20b, or qwen/qwen3.8-27b)
VITE_GROQ_MODEL=openai/gpt-oss-120b
VITE_MAPBOX_TOKEN=YOUR_MAPBOX_TOKEN_HERE
